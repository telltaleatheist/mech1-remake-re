; MW1: Critical Hit's event panel (src/mw1_event_screen.h) on MW1's screen
; template (src/mw1_screen.h): MW1's story texts, read from the player's
; MW_MAIN.EXE, green on black as MW1 showed them, over the screen they fire
; on. The backdrop is MW1's own black (mw1image.zbd); the buttons are Pirate's
; Moon's, read from the player's install (never copied). A choice's buttons
; carry MW1's captions (the screen gives their words); NEXT says NEXT or OK.
; LABEL_AT is MW1's key.
(
SHARED_IMAGE_PATH ("..\data\common\images\dialogs\shared;..\data\common\images\dialogs\briefing")
MW1EVENTDIALOG (
  IMAGE_PATH ("..\data\common\images\dialogs\briefing;..\data\common\images;..\data\common\images\dialogs\shared;..\data\common\images\dialogs\mainmenu")
  CURSOR (BITMAP ("cursor_circle_orange") CENTER (1))
  PRIMITIVES (BACKGROUND (POSITION (0 0) BITMAP ("mw1_black")))
  BUTTONS (
    ; The choices: up to three, MW1's captions.
    CHOICE1 (POSITION (24 440) BITMAP ("circlebtn_tiny") DISABLE (BITMAP ("circlebtn_tiny_grey")) LABEL_AT (70 454))
    CHOICE2 (POSITION (216 440) BITMAP ("circlebtn_tiny") DISABLE (BITMAP ("circlebtn_tiny_grey")) LABEL_AT (262 454))
    CHOICE3 (POSITION (408 440) BITMAP ("circlebtn_tiny") DISABLE (BITMAP ("circlebtn_tiny_grey")) LABEL_AT (454 454))
    ; The next page (or OK); the news's previous story and BACK.
    NEXT (POSITION (536 440) BITMAP ("circlebtn_tiny") DISABLE (BITMAP ("circlebtn_tiny_grey")) LABEL_AT (582 454))
    PREV (POSITION (24 440) BITMAP ("circlebtn_tiny") DISABLE (BITMAP ("circlebtn_tiny_grey")) LABEL_AT (70 454))
    BACK (POSITION (280 440) BITMAP ("circlebtn_tiny") DISABLE (BITMAP ("circlebtn_tiny_grey")) LABEL_AT (326 454))
  )
)
)
