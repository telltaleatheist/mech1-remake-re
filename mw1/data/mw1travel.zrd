; MW1: Critical Hit's travel screen (src/mw1_travel_screen.h) on MW1's screen
; template (src/mw1_screen.h): the star map. The backdrop is MW1's own black;
; the map's images are ours, drawn at build time from the worlds' data
; (src/mw1_map_image.h, mw1image.zbd): PANEL the whole map, PANEL2..PANEL6
; each House's lit (FILTER's one House), one shown at a time, at the map area
; (src/mw1_travel_map.h: 16, 64). The worlds, the markers and the names are
; drawn over it by the screen. The round buttons are Pirate's Moon's, read
; from the player's install (never copied). LABEL_AT is MW1's key.
(
MW1TRAVELDIALOG (
  CURSOR (BITMAP ("mw1_cursor") CENTER (1))
  PRIMITIVES (
    BACKGROUND (POSITION (-107 0) BITMAP ("mw1_black") ANCHOR ("CENTRE"))
    PANEL (POSITION (16 64) BITMAP ("mw1_map"))
    PANEL2 (POSITION (16 64) BITMAP ("mw1_map_kurita"))
    PANEL3 (POSITION (16 64) BITMAP ("mw1_map_steiner"))
    PANEL4 (POSITION (16 64) BITMAP ("mw1_map_marik"))
    PANEL5 (POSITION (16 64) BITMAP ("mw1_map_liao"))
    PANEL6 (POSITION (16 64) BITMAP ("mw1_map_davion"))
  )
  BUTTONS (
    GO (POSITION (24 436) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (116 442) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    FILTER (POSITION (236 436) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (328 442) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    BACK (POSITION (448 436) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (540 442) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
  )
)
)
