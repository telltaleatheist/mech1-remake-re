; MW1: Critical Hit's Bar (src/mw1_bar_screen.h) on MW1's screen template
; (src/mw1_screen.h). Only names here: the images are Pirate's Moon's, read
; from the player's install (never copied); MW1's own art takes these names'
; places later. No portraits (mw1 lead 2026-11-17: not the EGA ones).
;
; The main menu's backdrop (borrowed); PM's popup box behind the recruits and
; the lance; PM's list arrows to choose in them; the round button with MW1's
; words for the rest, greyed as PM greys it. LABEL_AT is MW1's key.
(
SHARED_IMAGE_PATH ("..\data\common\images\dialogs\shared;..\data\common\images\dialogs\briefing")
MW1BARDIALOG (
  IMAGE_PATH ("..\data\common\images\dialogs\briefing;..\data\common\images;..\data\common\images\dialogs\shared;..\data\common\images\dialogs\mainmenu;..\data\common\images\dialog\multiplayer;..\data\common\images\dialogs\pilotreg")
  CURSOR (BITMAP ("mw1_cursor") CENTER (1))
  PRIMITIVES (PANEL (POSITION (16 64) BITMAP ("popup_box")) PANEL2 (POSITION (384 64) BITMAP ("popup_box")))
  BUTTONS (
    HIRE (POSITION (24 440) BITMAP ("circlebtn_tiny") DISABLE (BITMAP ("circlebtn_tiny_grey")) LABEL_AT (70 454))
    DECLINE (POSITION (152 440) BITMAP ("circlebtn_tiny") DISABLE (BITMAP ("circlebtn_tiny_grey")) LABEL_AT (198 454))
    FIRE (POSITION (280 440) BITMAP ("circlebtn_tiny") DISABLE (BITMAP ("circlebtn_tiny_grey")) LABEL_AT (326 454))
    ASSIGN (POSITION (408 440) BITMAP ("circlebtn_tiny") DISABLE (BITMAP ("circlebtn_tiny_grey")) LABEL_AT (454 454))
    BACK (POSITION (536 440) BITMAP ("circlebtn_tiny") DISABLE (BITMAP ("circlebtn_tiny_grey")) LABEL_AT (582 454))
    ; MW1's drink (a tip, at the tip's price: the story's, src/mw1_story.h) and the news, between the panels.
    DRINK (POSITION (272 96) BITMAP ("circlebtn_tiny") DISABLE (BITMAP ("circlebtn_tiny_grey")) LABEL_AT (318 110))
    NEWS (POSITION (272 128) BITMAP ("circlebtn_tiny") DISABLE (BITMAP ("circlebtn_tiny_grey")) LABEL_AT (318 142))
    ; The lists' arrows, at their panels' right edges.
    RECRUIT_UP (POSITION (232 92) BITMAP ("arrowupmp_normal") ACTIVATE (BITMAP ("arrowupmp_rollover")) DISABLE (BITMAP ("arrowupmp_d")))
    RECRUIT_DOWN (POSITION (232 230) BITMAP ("arrowdnmp_normal") ACTIVATE (BITMAP ("arrowdnmp_rollover")) DISABLE (BITMAP ("arrowdnmp_d")))
    LANCE_UP (POSITION (600 92) BITMAP ("arrowupmp_normal") ACTIVATE (BITMAP ("arrowupmp_rollover")) DISABLE (BITMAP ("arrowupmp_d")))
    LANCE_DOWN (POSITION (600 160) BITMAP ("arrowdnmp_normal") ACTIVATE (BITMAP ("arrowdnmp_rollover")) DISABLE (BITMAP ("arrowdnmp_d")))
  )
)
)
