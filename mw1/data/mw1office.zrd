    ADVANCE_DOWN (POSITION (548 400) BITMAP ("mw1_dn") ROLLOVER (BITMAP ("mw1_dn_lit")) ACTIVATE (BITMAP ("mw1_dn_down")) DISABLE (BITMAP ("mw1_dn_off")))
    ADVANCE_UP (POSITION (582 400) BITMAP ("mw1_up") ROLLOVER (BITMAP ("mw1_up_lit")) ACTIVATE (BITMAP ("mw1_up_down")) DISABLE (BITMAP ("mw1_up_off")))
  )
  TEXTS (
    PLANET (POSITION (162 15) FONT ("mw1_plaque"))
    HOUSE (POSITION (162 47) FONT ("mw1_plaque_sub"))
    PLACE (POSITION (478 15) FONT ("mw1_plaque"))
    PLACE_SUB (POSITION (478 47) FONT ("mw1_plaque_sub"))
    STATUS_WORLD (POSITION (16 460) FONT ("mw1_status_world"))
    STATUS (POSITION (132 461) FONT ("mw1_status"))
    C_TITLE (POSITION (202 86) FONT ("mw1_panel_title"))
    C_LINES (POSITION (202 112) FONT ("mw1_panel_line") GAP (15))
    NOTES (POSITION (202 226) FONT ("mw1_note") GAP (15))
    T_TITLE (POSITION (200 282) FONT ("mw1_term_title"))
