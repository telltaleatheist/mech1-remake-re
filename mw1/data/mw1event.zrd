; MW1: Critical Hit's event panel (src/mw1_event_screen.h) on MW1's screen
; template (src/mw1_screen.h): MW1's story texts, read from the player's
; MW_MAIN.EXE. MW1EVENTDIALOG, a full screen of its own (FIXES.md item 10),
; only for an event whose page is its own art (event_art; item 42 keeps it):
; - the event's art full-bleed and dimmed (the screen names it);
; - the world and the place (ARRIVAL, THE BAR, ...) on the plaque at the top;
; - the text on the green terminal in the middle, the page's count at its
;   top right;
; - MW1's framed buttons under it: a choice's captions (up to three across),
;   else NEXT or OK in the middle; the news's PREV, NEXT and BACK.
; All MW1's own art (mw1image.zbd): nothing of Pirate's Moon's
; (tests/test_mw1_look.cpp). A 4:3 layout, each piece anchored to the
; canvas's middle (the 16:9 canvas shows the scene's full width).
(
MW1EVENTDIALOG (
  CURSOR (BITMAP ("mw1_cursor") CENTER (1))
  PRIMITIVES (
    BACKGROUND (POSITION (-107 0) BITMAP ("mw1_hub_desert_starport") ANCHOR ("CENTRE"))
    PANEL (POSITION (-107 0) BITMAP ("mw1_dim") ANCHOR ("CENTRE"))
    PANEL2 (POSITION (170 16) BITMAP ("mw1_plaque") ANCHOR ("CENTRE"))
    PANEL3 (POSITION (102 82) BITMAP ("mw1_term_436x300") ANCHOR ("CENTRE"))
  )
  BUTTONS (
    ; The choices: up to three, MW1's captions.
    CHOICE1 (POSITION (52 398) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (144 404) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off") ANCHOR ("CENTRE"))
    CHOICE2 (POSITION (236 398) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (328 404) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off") ANCHOR ("CENTRE"))
    CHOICE3 (POSITION (420 398) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (512 404) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off") ANCHOR ("CENTRE"))
    ; The next page (or OK) in the middle; the news's previous story left of it, BACK right.
    NEXT (POSITION (236 398) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (328 404) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off") ANCHOR ("CENTRE"))
    PREV (POSITION (52 398) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (144 404) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off") ANCHOR ("CENTRE"))
    BACK (POSITION (420 398) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (512 404) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off") ANCHOR ("CENTRE"))
    ; FIXES.md item 63: the LOG's READ (a page's news stories), top right beside the plaque.
    READ (POSITION (520 24) BITMAP ("mw1_button_tile") ROLLOVER (BITMAP ("mw1_button_tile_lit")) ACTIVATE (BITMAP ("mw1_button_tile_down")) DISABLE (BITMAP ("mw1_button_tile_off")) LABEL_AT (574 30) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off") ANCHOR ("CENTRE"))
  )
  TEXTS (
    PLANET (POSITION (320 23) FONT ("mw1_plaque") ANCHOR ("CENTRE"))
    PLACE (POSITION (320 55) FONT ("mw1_plaque_sub") ANCHOR ("CENTRE"))
    PAGE (POSITION (522 90) FONT ("mw1_term_value") ANCHOR ("CENTRE"))
    LINES (POSITION (124 104) FONT ("mw1_term_line") GAP (15) ANCHOR ("CENTRE"))
  )
)
; A message at the foot of the screen it fires over (FIXES.md item 42, the owner: unobtrusive, the artwork above it
; clear and undimmed; revises item 34's side panels): MW1EVENTBOTTOM, the screen's own picture full-bleed behind
; (the screen names it), a box sized to its text (mw1_box_560_<lines>, its picture's foot at the canvas's foot less
; 10, so it grows upward; the screen names the size), the world and the place on its title row, the page's count at
; its right, up to six lines (then pages), the buttons in a row inside its foot: a choice's captions across; NEXT or
; OK right; the news's PREV left, BACK in the middle, NEXT right. A 4:3 layout (16:9's below). The
; texts' places are the six-line box's; the screen moves them down for fewer lines.
MW1EVENTBOTTOM (
  CURSOR (BITMAP ("mw1_cursor") CENTER (1))
  PRIMITIVES (
    BACKGROUND (POSITION (-107 0) BITMAP ("mw1_bar_scene") ANCHOR ("CENTRE"))
    PANEL (POSITION (40 298) BITMAP ("mw1_box_560_6"))
  )
  BUTTONS (
    CHOICE1 (POSITION (56 430) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (148 436) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    CHOICE2 (POSITION (236 430) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (328 436) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    CHOICE3 (POSITION (416 430) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (508 436) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    NEXT (POSITION (416 430) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (508 436) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    PREV (POSITION (56 430) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (148 436) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    BACK (POSITION (236 430) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (328 436) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    ; The LOG's READ is the full page's alone: here at BACK's place, never shown.
    READ (POSITION (236 430) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (328 436) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
  )
  TEXTS (
    TITLE (POSITION (56 308) FONT ("mw1_term_title"))
    PAGE (POSITION (584 310) FONT ("mw1_term_value"))
    LINES (POSITION (56 332) FONT ("mw1_term_line") GAP (15))
  )
)
; MW1EVENTBOTTOM_WIDE: the same on the 16:9 canvas (853), the box 760 wide
; (mw1_box_760_<lines>) across its middle, the text rewrapped to it (boxed_pages'
; columns), the buttons spread along its foot.
MW1EVENTBOTTOM_WIDE (
  CURSOR (BITMAP ("mw1_cursor") CENTER (1))
  PRIMITIVES (
    BACKGROUND (POSITION (0 0) BITMAP ("mw1_bar_scene") ANCHOR ("CENTRE"))
    PANEL (POSITION (46 298) BITMAP ("mw1_box_760_6") ANCHOR ("CENTRE"))
  )
  BUTTONS (
    CHOICE1 (POSITION (62 430) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (154 436) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off") ANCHOR ("CENTRE"))
    CHOICE2 (POSITION (342 430) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (434 436) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off") ANCHOR ("CENTRE"))
    CHOICE3 (POSITION (622 430) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (714 436) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off") ANCHOR ("CENTRE"))
    NEXT (POSITION (622 430) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (714 436) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off") ANCHOR ("CENTRE"))
    PREV (POSITION (62 430) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (154 436) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off") ANCHOR ("CENTRE"))
    BACK (POSITION (342 430) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (434 436) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off") ANCHOR ("CENTRE"))
    ; The LOG's READ is the full page's alone: here at BACK's place, never shown.
    READ (POSITION (342 430) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (434 436) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off") ANCHOR ("CENTRE"))
  )
  TEXTS (
    TITLE (POSITION (62 308) FONT ("mw1_term_title") ANCHOR ("CENTRE"))
    PAGE (POSITION (790 310) FONT ("mw1_term_value") ANCHOR ("CENTRE"))
    LINES (POSITION (62 332) FONT ("mw1_term_line") GAP (15) ANCHOR ("CENTRE"))
  )
)
)
