; The side panels (FIXES.md item 34, Owen: like MW1's, a message over a screen keeps that screen's picture): the
; screen's own picture behind, undimmed (the screen names it), and the message in its free side, MW1EVENTLEFT or
; MW1EVENTRIGHT (mw1_event_screen.h's Side; each screen's side there): the plaque over a 392 wide terminal (MW1's
; widest line, 44 characters, with its margins), the buttons under it two across (a third choice, BACK, under the
; right one). The pages with their own art (event_art) keep the full page above. 4:3 and _WIDE (853), each from its
; side.
; MW1: Critical Hit's event panel (src/mw1_event_screen.h) on MW1's screen
; template (src/mw1_screen.h): MW1's story texts, read from the player's
; MW_MAIN.EXE, a full screen of its own (FIXES.md item 10):
; - the event's scene full-bleed and dimmed (the screen names it: the event's
;   own art, else the world's hub scenery; mw1_story.h's event_art);
; - the world and the place (ARRIVAL, THE BAR, ...) on the plaque at the top;
; - the text on the green terminal in the middle, the page's count at its
;   top right;
; - MW1's framed buttons under it: a choice's captions (up to three across),
;   else NEXT or OK in the middle; the news's PREV, NEXT and BACK.
; All MW1's own art (mw1image.zbd): nothing of Pirate's Moon's
; (tests/test_mw1_look.cpp). A 4:3 layout, each piece anchored to the
; canvas's middle (the 16:9 canvas shows the scene's full width).
(
MW1EVENTDIALOG (
  CURSOR (BITMAP ("mw1_cursor") CENTER (1))
  PRIMITIVES (
    BACKGROUND (POSITION (-107 0) BITMAP ("mw1_hub_desert_starport") ANCHOR ("CENTRE"))
    PANEL (POSITION (-107 0) BITMAP ("mw1_dim") ANCHOR ("CENTRE"))
    PANEL2 (POSITION (170 16) BITMAP ("mw1_plaque") ANCHOR ("CENTRE"))
    PANEL3 (POSITION (102 82) BITMAP ("mw1_term_436x300") ANCHOR ("CENTRE"))
  )
  BUTTONS (
    ; The choices: up to three, MW1's captions.
    CHOICE1 (POSITION (52 398) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (144 404) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off") ANCHOR ("CENTRE"))
    CHOICE2 (POSITION (236 398) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (328 404) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off") ANCHOR ("CENTRE"))
    CHOICE3 (POSITION (420 398) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (512 404) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off") ANCHOR ("CENTRE"))
    ; The next page (or OK) in the middle; the news's previous story left of it, BACK right.
    NEXT (POSITION (236 398) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (328 404) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off") ANCHOR ("CENTRE"))
    PREV (POSITION (52 398) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (144 404) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off") ANCHOR ("CENTRE"))
    BACK (POSITION (420 398) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (512 404) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off") ANCHOR ("CENTRE"))
  )
  TEXTS (
    PLANET (POSITION (320 23) FONT ("mw1_plaque") ANCHOR ("CENTRE"))
    PLACE (POSITION (320 55) FONT ("mw1_plaque_sub") ANCHOR ("CENTRE"))
    PAGE (POSITION (522 90) FONT ("mw1_term_value") ANCHOR ("CENTRE"))
    LINES (POSITION (124 104) FONT ("mw1_term_line") GAP (15) ANCHOR ("CENTRE"))
  )
)
