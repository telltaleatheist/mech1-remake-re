    TAKE_SINK (POSITION (16 286) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (108 292) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    ADD_ARMOUR (POSITION (16 324) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (108 330) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    TAKE_ARMOUR (POSITION (16 362) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (108 368) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    ; Each list's arrows, inside its terminal's right edge.
    SALE_UP (POSITION (803 104) BITMAP ("mw1_up") ROLLOVER (BITMAP ("mw1_up_lit")) ACTIVATE (BITMAP ("mw1_up_down")) DISABLE (BITMAP ("mw1_up_off")))
    SALE_DOWN (POSITION (803 218) BITMAP ("mw1_dn") ROLLOVER (BITMAP ("mw1_dn_lit")) ACTIVATE (BITMAP ("mw1_dn_down")) DISABLE (BITMAP ("mw1_dn_off")))
    OWN_UP (POSITION (803 284) BITMAP ("mw1_up") ROLLOVER (BITMAP ("mw1_up_lit")) ACTIVATE (BITMAP ("mw1_up_down")) DISABLE (BITMAP ("mw1_up_off")))
    OWN_DOWN (POSITION (803 398) BITMAP ("mw1_dn") ROLLOVER (BITMAP ("mw1_dn_lit")) ACTIVATE (BITMAP ("mw1_dn_down")) DISABLE (BITMAP ("mw1_dn_off")))
  )
  TEXTS (
    PLANET (POSITION (166 15) FONT ("mw1_plaque"))
    HOUSE (POSITION (166 47) FONT ("mw1_plaque_sub"))
    PLACE (POSITION (687 15) FONT ("mw1_plaque") ANCHOR ("RIGHT"))
    PLACE_SUB (POSITION (687 47) FONT ("mw1_plaque_sub") ANCHOR ("RIGHT"))
    STATUS_WORLD (POSITION (20 460) FONT ("mw1_status_world"))
    STATUS (POSITION (136 461) FONT ("mw1_status"))
    S_TITLE (POSITION (216 86) FONT ("mw1_term_title"))
    S_HEAD (POSITION (216 108) FONT ("mw1_term_dim"))
    S_ROWS (POSITION (216 128) FONT ("mw1_term_line") GAP (15))
    S_ROWS_DIM (POSITION (216 128) FONT ("mw1_term_dim") GAP (15))
    O_TITLE (POSITION (216 266) FONT ("mw1_term_title"))
    O_HEAD (POSITION (216 288) FONT ("mw1_term_dim"))
