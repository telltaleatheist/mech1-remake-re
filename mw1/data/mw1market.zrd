; MW1: Critical Hit's market (src/mw1_market_screen.h) on MW1's screen
; template (src/mw1_screen.h). Only names here: the images are Pirate's
; Moon's, read from the player's install (never copied); MW1's own art takes
; these names' places later.
;
; The main menu's backdrop (borrowed); PM's popup box (the briefing's salvage
; list) behind the two lists; PM's list arrows (the multiplayer screens')
; to choose in them; the round button with MW1's words for the rest, greyed
; as PM greys it. LABEL_AT is MW1's key (the game's readers ignore it).
(
MW1MARKETDIALOG (
  CURSOR (BITMAP ("mw1_cursor") CENTER (1))
  ; MW1's own scene behind it (no main menu to borrow one from: MW1 builds none).
  PRIMITIVES (BACKGROUND (POSITION (-107 0) BITMAP ("mw1_mechcomplex_dealer") ANCHOR ("CENTRE"))
    PANEL (POSITION (16 64) BITMAP ("mw1_panel_232x244")) PANEL2 (POSITION (384 64) BITMAP ("mw1_panel_232x244")))
  BUTTONS (
    BUY (POSITION (24 436) BITMAP ("mw1_button_s") ROLLOVER (BITMAP ("mw1_button_s_lit")) ACTIVATE (BITMAP ("mw1_button_s_down")) DISABLE (BITMAP ("mw1_button_s_off")) LABEL_AT (90 442) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    SELL (POSITION (176 436) BITMAP ("mw1_button_s") ROLLOVER (BITMAP ("mw1_button_s_lit")) ACTIVATE (BITMAP ("mw1_button_s_down")) DISABLE (BITMAP ("mw1_button_s_off")) LABEL_AT (242 442) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    PILOT (POSITION (328 436) BITMAP ("mw1_button_s") ROLLOVER (BITMAP ("mw1_button_s_lit")) ACTIVATE (BITMAP ("mw1_button_s_down")) DISABLE (BITMAP ("mw1_button_s_off")) LABEL_AT (394 442) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    BACK (POSITION (480 436) BITMAP ("mw1_button_s") ROLLOVER (BITMAP ("mw1_button_s_lit")) ACTIVATE (BITMAP ("mw1_button_s_down")) DISABLE (BITMAP ("mw1_button_s_off")) LABEL_AT (546 442) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    ; The lists' arrows, at their panels' right edges.
    STOCK_UP (POSITION (232 92) BITMAP ("mw1_up") ROLLOVER (BITMAP ("mw1_up_lit")) ACTIVATE (BITMAP ("mw1_up_down")) DISABLE (BITMAP ("mw1_up_off")))
    STOCK_DOWN (POSITION (232 300) BITMAP ("mw1_dn") ROLLOVER (BITMAP ("mw1_dn_lit")) ACTIVATE (BITMAP ("mw1_dn_down")) DISABLE (BITMAP ("mw1_dn_off")))
    OWN_UP (POSITION (600 92) BITMAP ("mw1_up") ROLLOVER (BITMAP ("mw1_up_lit")) ACTIVATE (BITMAP ("mw1_up_down")) DISABLE (BITMAP ("mw1_up_off")))
    OWN_DOWN (POSITION (600 230) BITMAP ("mw1_dn") ROLLOVER (BITMAP ("mw1_dn_lit")) ACTIVATE (BITMAP ("mw1_dn_down")) DISABLE (BITMAP ("mw1_dn_off")))
  )
)
)
