; MW1: Critical Hit's Mech Complex (src/mw1_market_screen.h), on MW1's screen
; template (src/mw1_screen.h; ANCHOR, LABEL_AT, LABEL_FONT, LABEL_OFF_FONT, TEXTS
; and the _WIDE layout are ours). FIXES.md items 8 and 13, the owner's shape: one
; page, MW1's buttons down the left (BUY, SELL, MECH LAB,
; SUPPLY (1.1.0: mw1supply.zrd), BACK), FOR SALE's terminal over YOUR MECHS', each list with its arrows; under the
; buttons the chosen mech's render (FIXES.md item 14, PANEL6 and 7). The funds
; on the right plaque (PLACE); FOR SALE's rows the company can't afford in
; S_ROWS_DIM's darker green, at S_ROWS's place (FIXES.md item 41).
; All MW1's own art (mw1image.zbd): nothing of Pirate's Moon's.
;
; MW1MARKETDIALOG is 4:3's (640); MW1MARKETDIALOG_WIDE the 16:9 canvas's (853).
(
MW1MARKETDIALOG (
  CURSOR (BITMAP ("mw1_cursor") CENTER (1))
  PRIMITIVES (
    BACKGROUND (POSITION (-107 0) BITMAP ("mw1_mechcomplex_hangar") ANCHOR ("CENTRE"))
    PANEL (POSITION (12 8) BITMAP ("mw1_plaque"))
    PANEL2 (POSITION (328 8) BITMAP ("mw1_plaque"))
    PANEL3 (POSITION (-107 454) BITMAP ("mw1_statusbar") ANCHOR ("CENTRE"))
    PANEL4 (POSITION (188 76) BITMAP ("mw1_term_436x172"))
    PANEL5 (POSITION (188 256) BITMAP ("mw1_term_436x172"))
    PANEL6 (POSITION (12 308) BITMAP ("mw1_frame_168x136"))
    PANEL7 (POSITION (16 312) BITMAP ("mw1_clear"))
  )
  BUTTONS (
    ; Down the left, MW1's way (their ids are mw1_market_screen.h's, in this order).
    BUY (POSITION (12 84) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (104 90) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    SELL (POSITION (12 122) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (104 128) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    LAB (POSITION (12 160) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (104 166) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    SUPPLY (POSITION (12 198) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (104 204) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    BACK (POSITION (12 236) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (104 242) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    ; Each list's arrows, inside its terminal's right edge.
    STOCK_UP (POSITION (590 104) BITMAP ("mw1_up") ROLLOVER (BITMAP ("mw1_up_lit")) ACTIVATE (BITMAP ("mw1_up_down")) DISABLE (BITMAP ("mw1_up_off")))
    STOCK_DOWN (POSITION (590 218) BITMAP ("mw1_dn") ROLLOVER (BITMAP ("mw1_dn_lit")) ACTIVATE (BITMAP ("mw1_dn_down")) DISABLE (BITMAP ("mw1_dn_off")))
    OWN_UP (POSITION (590 284) BITMAP ("mw1_up") ROLLOVER (BITMAP ("mw1_up_lit")) ACTIVATE (BITMAP ("mw1_up_down")) DISABLE (BITMAP ("mw1_up_off")))
    OWN_DOWN (POSITION (590 398) BITMAP ("mw1_dn") ROLLOVER (BITMAP ("mw1_dn_lit")) ACTIVATE (BITMAP ("mw1_dn_down")) DISABLE (BITMAP ("mw1_dn_off")))
  )
  TEXTS (
    PLANET (POSITION (162 15) FONT ("mw1_plaque"))
    HOUSE (POSITION (162 47) FONT ("mw1_plaque_sub"))
    PLACE (POSITION (478 15) FONT ("mw1_plaque"))
    PLACE_SUB (POSITION (478 47) FONT ("mw1_plaque_sub"))
    STATUS_WORLD (POSITION (16 460) FONT ("mw1_status_world"))
    STATUS (POSITION (132 461) FONT ("mw1_status"))
    S_TITLE (POSITION (204 86) FONT ("mw1_term_title"))
    S_HEAD (POSITION (204 108) FONT ("mw1_term_dim"))
    S_ROWS (POSITION (204 128) FONT ("mw1_term_line") GAP (15))
    S_ROWS_DIM (POSITION (204 128) FONT ("mw1_term_dim") GAP (15))
    O_TITLE (POSITION (204 266) FONT ("mw1_term_title"))
    O_HEAD (POSITION (204 288) FONT ("mw1_term_dim"))
    O_ROWS (POSITION (204 308) FONT ("mw1_term_line") GAP (15))
  )
)
