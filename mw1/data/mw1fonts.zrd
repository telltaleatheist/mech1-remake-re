; MW1: Critical Hit's own fonts (fonts/README.md): added to the 2D host's
; fonts beside the game's fonts.zrd (ztwod::Host::add_font_table, ours). Each
; entry as fonts.zrd's (face, height, color, align, shadow), with our two
; keys: file (the face's .ttf, under MW1's data) and tracking (pixels between
; glyphs). Sizes for the 480-line canvas. weight stays 400: the files are the
; weights (a heavier weight would embolden them again). A centred or right
; font's x is the words' middle or right end.
(
WINDOWS_FONTS (
  ; The plaques: the world and the date in big tracked caps; the line under in amber.
  "mw1_plaque" (face "Saira Condensed ExtraBold" file "fonts\SairaCondensed-ExtraBold.ttf" height -26 tracking 3 align "center" color (233 236 238))
  "mw1_plaque_sub" (face "Share Tech Mono" file "fonts\ShareTechMono-Regular.ttf" height -11 tracking 2 align "center" color (255 176 64))
  ; The hub's company strip between the plaques: the labels in the plaques' amber, the values bright (x their right end).
  "mw1_strip_label" (face "Share Tech Mono" file "fonts\ShareTechMono-Regular.ttf" height -11 tracking 2 color (255 176 64))
  "mw1_strip_value" (face "Share Tech Mono" file "fonts\ShareTechMono-Regular.ttf" height -13 tracking 1 align "right" color (233 236 238))
  ; The title screen's name and the line under it.
  "mw1_title" (face "Saira Condensed ExtraBold" file "fonts\SairaCondensed-ExtraBold.ttf" height -54 tracking 5 shadow "true" color (240 242 244))
  "mw1_title_43" (face "Saira Condensed ExtraBold" file "fonts\SairaCondensed-ExtraBold.ttf" height -44 tracking 4 shadow "true" color (240 242 244))  ; 4:3's, clear of the mech
  "mw1_title_sub" (face "Saira Condensed Bold" file "fonts\SairaCondensed-Bold.ttf" height -22 tracking 4 shadow "true" color (255 176 64))
  ; A tile's or a button's words, lit and greyed.
  "mw1_label" (face "Saira Condensed Bold" file "fonts\SairaCondensed-Bold.ttf" height -15 tracking 2 align "center" color (217 221 224))
  "mw1_label_off" (face "Saira Condensed Bold" file "fonts\SairaCondensed-Bold.ttf" height -15 tracking 2 align "center" color (96 100 104))
  ; A picture tile's words, in the band at its foot (the tile 108 across: "MECH COMPLEX" fits).
  "mw1_tile_label" (face "Saira Condensed Bold" file "fonts\SairaCondensed-Bold.ttf" height -13 tracking 1 align "center" color (217 221 224))
  "mw1_tile_label_off" (face "Saira Condensed Bold" file "fonts\SairaCondensed-Bold.ttf" height -13 tracking 1 align "center" color (96 100 104))
  ; A framed panel's title and lines.
  "mw1_panel_title" (face "Saira Condensed Bold" file "fonts\SairaCondensed-Bold.ttf" height -17 tracking 3 color (255 176 64))
  "mw1_panel_line" (face "Share Tech Mono" file "fonts\ShareTechMono-Regular.ttf" height -13 color (210 214 218))
  ; The green terminal: its title, the labels dim, the values bright (x their right end), a plain bright line.
  "mw1_term_title" (face "Saira Condensed Bold" file "fonts\SairaCondensed-Bold.ttf" height -16 tracking 3 color (110 250 150))
  "mw1_term_dim" (face "Share Tech Mono" file "fonts\ShareTechMono-Regular.ttf" height -13 tracking 1 color (56 150 88))
  "mw1_term_value" (face "Share Tech Mono" file "fonts\ShareTechMono-Regular.ttf" height -13 tracking 1 align "right" color (130 255 165))
  "mw1_term_line" (face "Share Tech Mono" file "fonts\ShareTechMono-Regular.ttf" height -13 tracking 1 color (130 255 165))
  ; A message box's title (centred) and its words.
  "mw1_dialog_title" (face "Saira Condensed Bold" file "fonts\SairaCondensed-Bold.ttf" height -18 tracking 3 align "center" color (255 176 64))
  "mw1_dialog_title_left" (face "Saira Condensed Bold" file "fonts\SairaCondensed-Bold.ttf" height -18 tracking 3 color (255 176 64))
  "mw1_dialog_text" (face "Share Tech Mono" file "fonts\ShareTechMono-Regular.ttf" height -14 color (222 226 230))
  ; The options' lines greyed (left-aligned), and a choice's value.
  "mw1_line_off" (face "Share Tech Mono" file "fonts\ShareTechMono-Regular.ttf" height -13 color (96 100 104))
  "mw1_value" (face "Share Tech Mono" file "fonts\ShareTechMono-Regular.ttf" height -13 tracking 1 color (255 176 64))
  "mw1_value_alert" (face "Share Tech Mono" file "fonts\ShareTechMono-Regular.ttf" height -13 tracking 1 color (255 84 60))
  ; A control table's key (its cell narrow): the row's and the row shown's.
  "mw1_cell_text" (face "Share Tech Mono" file "fonts\ShareTechMono-Regular.ttf" height -11 color (210 214 218))
  "mw1_cell_value" (face "Share Tech Mono" file "fonts\ShareTechMono-Regular.ttf" height -11 color (255 176 64))
  ; The status line: the world in grey caps, the message in amber; a note (the title screen's save) the same amber.
  "mw1_status_world" (face "Saira Condensed Bold" file "fonts\SairaCondensed-Bold.ttf" height -15 tracking 2 color (165 170 176))
  "mw1_status" (face "Share Tech Mono" file "fonts\ShareTechMono-Regular.ttf" height -13 tracking 1 color (255 176 64))
  "mw1_note" (face "Share Tech Mono" file "fonts\ShareTechMono-Regular.ttf" height -13 tracking 1 shadow "true" color (255 176 64))
  ; The lab's reskin (Pirate's Moon's lab fonts by name, in its file only: mw1_lab_skin.h). FIXES.md item 17: at PM's
  ; own heights (Arial's, positive: the cell, so PM's rows 11 apart hold them) in Share Tech, Share Tech Mono's
  ; proportional sibling (Arial's widths: PM's columns and tabs hold it; it rasterises cleanly at 1x, where the mono
  ; at a fitting size loses its zero), untracked; the titles and the section headings in Saira, 18 high. Green the
  ; live words (a choice), amber the chosen and the titles, grey off.
  "mw1_lab_small_green" (face "Share Tech" file "fonts\ShareTech-Regular.ttf" height 12 color (130 255 165))
  "mw1_lab_small_greenR" (face "Share Tech" file "fonts\ShareTech-Regular.ttf" height 12 align "right" color (130 255 165))
  "mw1_lab_small_greenC" (face "Share Tech" file "fonts\ShareTech-Regular.ttf" height 12 align "center" color (130 255 165))
  "mw1_lab_small_red" (face "Share Tech" file "fonts\ShareTech-Regular.ttf" height 12 color (255 176 64))
  "mw1_lab_small_redR" (face "Share Tech" file "fonts\ShareTech-Regular.ttf" height 12 align "right" color (255 176 64))
  "mw1_lab_small_white" (face "Share Tech" file "fonts\ShareTech-Regular.ttf" height 12 color (217 221 224))
  "mw1_lab_small_whiteR" (face "Share Tech" file "fonts\ShareTech-Regular.ttf" height 12 align "right" color (217 221 224))
  "mw1_lab_small_whiteC" (face "Share Tech" file "fonts\ShareTech-Regular.ttf" height 12 align "center" color (217 221 224))
  "mw1_lab_small_grey" (face "Share Tech" file "fonts\ShareTech-Regular.ttf" height 12 color (96 100 104))
  "mw1_lab_small_greyR" (face "Share Tech" file "fonts\ShareTech-Regular.ttf" height 12 align "right" color (96 100 104))
  "mw1_lab_small_title" (face "Share Tech" file "fonts\ShareTech-Regular.ttf" height 12 color (255 176 64))
  "mw1_lab_large_green" (face "Share Tech" file "fonts\ShareTech-Regular.ttf" height 16 color (130 255 165))
  "mw1_lab_large_greenR" (face "Share Tech" file "fonts\ShareTech-Regular.ttf" height 16 align "right" color (130 255 165))
  "mw1_lab_large_red" (face "Share Tech" file "fonts\ShareTech-Regular.ttf" height 16 color (255 176 64))
  "mw1_lab_large_redR" (face "Share Tech" file "fonts\ShareTech-Regular.ttf" height 16 align "right" color (255 176 64))
  "mw1_lab_large_white" (face "Saira Condensed Bold" file "fonts\SairaCondensed-Bold.ttf" height 18 tracking 1 color (217 221 224))
  "mw1_lab_large_whiteR" (face "Share Tech" file "fonts\ShareTech-Regular.ttf" height 16 align "right" color (217 221 224))
  "mw1_lab_large_title" (face "Saira Condensed Bold" file "fonts\SairaCondensed-Bold.ttf" height 18 tracking 1 color (255 176 64))
)
)
