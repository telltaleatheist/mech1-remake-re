; MW1: Critical Hit's maps (src/mw1_missions.h): the Instant Action maps MW1's contracts are fought on, and the
; structures each offers (research/maps.md). Only names here: the maps are the player's Pirate's Moon's and the
; MW3 worlds converted at the first run (never copied).
;
; A row: WORLD (the world's folder), IA (its readeria<n>.zbd), CLIMATE (desert, tropical or ice: MW1's three),
; KIND (any: a battle to destroy all; reach: get within 40 m of the NODE, a world node; attack: destroy the NODE,
; a targets.zrd entity; defend: destroy the enemies while the NODE stands), WORDS (as the offer says it).
;
; Attack rows are on each map's own Attack archive (ia2), where the structure is the enemy's and they guard it;
; defend rows on its Defend archive (ia3), where it's yours and they come for it. Every row here passes the
; survey (tests/test_mw1_loop.cpp, mw1_loop_every_map_row_is_there_headless): a structure the engine
; can't find would count as destroyed at once. FIXES 134: the survey also checks where it stands. An attack's
; target is on the enemies' side, away from the start (at least 150 m from it, at least halfway to the enemies'
; centre), though a player who tries may slip past them to it; a defence's is on the player's side (at most halfway
; to the enemies, nearer the start than the enemies), so they come through the player to reach it; a reach's place
; (MW1's withdraw) is at least 150 m from the start, whichever way it leads.
;
; PM's four worlds are desert at a stretch (c1 and c3 volcanic; research/maps.md), MW3's Grasslands (mw3c2) the
; one green map; no Instant Action map is ice yet (research/maps.md, "Arctic").
(
; Where each world's battles come from (FIXES.md item 46, agreed with Owen): MOSTLY about 75% of the time
; (mw1_missions.h kMostlyPercent), else SOMETIMES; never any other world. A planet's pool (Ander's Moon) comes
; before its climate's. The worlds: PM's c1..c4; MW3's mw3c1 Big Lake, mw3c2 Grasslands, mw3c3 Rolling Hills,
; mw3c4 Gorge, and mw3c4b the arctic (item 44, none yet: its MOSTLY then draws from SOMETIMES).
POOL (CLIMATE ("desert") MOSTLY ("c1" "c2" "c3" "c4" "mw3c1" "mw3c4") SOMETIMES ("mw3c2" "mw3c3"))
POOL (CLIMATE ("tropical") MOSTLY ("mw3c2" "mw3c3" "mw3c1") SOMETIMES ("c1" "c2" "c3" "c4" "mw3c4"))
POOL (CLIMATE ("ice") MOSTLY ("mw3c4b") SOMETIMES ("mw3c2" "mw3c3" "mw3c4"))
POOL (PLANET ("ANDER'S MOON") MOSTLY ("c1" "c2" "c3" "c4"))
; Battles: destroy all, on each world's Instant Action maps 1 and 3 (item 46). Map 2, the Attack archive, is in play
; through its reach and attack rows: a battle there never ends with the enemies disabled (its own scenario keeps it
; open; item 45's test).
MAP (WORLD ("c1") IA (1) CLIMATE ("desert") KIND ("any"))
MAP (WORLD ("c1") IA (3) CLIMATE ("desert") KIND ("any"))
MAP (WORLD ("c2") IA (1) CLIMATE ("desert") KIND ("any"))
MAP (WORLD ("c2") IA (3) CLIMATE ("desert") KIND ("any"))
MAP (WORLD ("c3") IA (1) CLIMATE ("desert") KIND ("any"))
MAP (WORLD ("c3") IA (3) CLIMATE ("desert") KIND ("any"))
MAP (WORLD ("c4") IA (1) CLIMATE ("desert") KIND ("any"))
MAP (WORLD ("c4") IA (3) CLIMATE ("desert") KIND ("any"))
MAP (WORLD ("mw3c1") IA (1) CLIMATE ("tropical") KIND ("any"))
MAP (WORLD ("mw3c1") IA (3) CLIMATE ("tropical") KIND ("any"))
MAP (WORLD ("mw3c2") IA (1) CLIMATE ("tropical") KIND ("any"))
MAP (WORLD ("mw3c2") IA (3) CLIMATE ("tropical") KIND ("any"))
MAP (WORLD ("mw3c3") IA (1) CLIMATE ("tropical") KIND ("any"))
MAP (WORLD ("mw3c3") IA (3) CLIMATE ("tropical") KIND ("any"))
MAP (WORLD ("mw3c4") IA (1) CLIMATE ("desert") KIND ("any"))
MAP (WORLD ("mw3c4") IA (3) CLIMATE ("desert") KIND ("any"))
MAP (WORLD ("mw3c4b") IA (1) CLIMATE ("ice") KIND ("any"))
; MW1's arctic map 1 (item 44, laid from data/arctic/ia1): c4b's warehouses. The company starts beside the south
; warehouse, the defence's (FIXES 137).
MAP (WORLD ("mw3c4b") IA (1) CLIMATE ("ice") KIND ("reach") NODE ("ware02") WORDS ("the depot"))
MAP (WORLD ("mw3c4b") IA (1) CLIMATE ("ice") KIND ("attack") NODE ("ware01") WORDS ("the supply warehouse"))
MAP (WORLD ("mw3c4b") IA (1) CLIMATE ("ice") KIND ("defend") NODE ("ware03") WORDS ("the south warehouse"))
; MW1's arctic map 2 (data/arctic/ia2).
MAP (WORLD ("mw3c4b") IA (2) CLIMATE ("ice") KIND ("any"))
MAP (WORLD ("mw3c4b") IA (2) CLIMATE ("ice") KIND ("reach") NODE ("ware02") WORDS ("the depot"))
MAP (WORLD ("mw3c4b") IA (2) CLIMATE ("ice") KIND ("attack") NODE ("ware01") WORDS ("the supply warehouse"))
MAP (WORLD ("mw3c4b") IA (2) CLIMATE ("ice") KIND ("defend") NODE ("ware03") WORDS ("the south warehouse"))
; Reach (MW1's withdraw). Each reachable by keeping 200 m from the enemy (FIXES 136; the survey's route): MW3's IA
; towers stand among their defenders, so the mw3cN rows name another building; c2 ia2 has none clear of the enemy
; (its portal gate 32 m from one), so no structure reach there (a nav point instead, below). The route walked on
; the engine's walking grid (FIXES 136 (a)):
; mw3c2 ia2's hangar stands 182 m below the start, in a pit no walk reaches (the engine's own pathfinder's too), and
; no other building there is a place a player reads, so no structure reach on mw3c2 (nav points, below).
MAP (WORLD ("c2") IA (1) CLIMATE ("desert") KIND ("reach") NODE ("3twr1") WORDS ("the pump complex"))
MAP (WORLD ("c3") IA (1) CLIMATE ("desert") KIND ("reach") NODE ("xslid01") WORDS ("the land bridge"))
MAP (WORLD ("c4") IA (1) CLIMATE ("desert") KIND ("reach") NODE ("modA140") WORDS ("the support building"))
MAP (WORLD ("mw3c1") IA (2) CLIMATE ("tropical") KIND ("reach") NODE ("urbbar02") WORDS ("the barracks"))
MAP (WORLD ("mw3c3") IA (2) CLIMATE ("tropical") KIND ("reach") NODE ("whsA01") WORDS ("the warehouses"))
MAP (WORLD ("mw3c4") IA (2) CLIMATE ("desert") KIND ("reach") NODE ("dockfal") WORDS ("the dock"))
; Reach at a nav point (FIXES 136, a project decision from the measured table): a point on open, walkable floor, at most
; 90 degrees at the start off the way to the enemies (to its side or toward them, never behind), 800 to 2500 m out,
; 200 m from every enemy place, out of a world's cloud death band, walked on the engine's grid round the enemy, and
; driven live with the enemy alive (seeds 1..3 all arrive; the damage taken on the way is the contract's, not gated).
; No Defend archive (ia3) and none where no point passes (mw3c3 ia1).
MAP (WORLD ("c1") IA (1) CLIMATE ("desert") KIND ("reach") POINT (2842 -1596) WORDS ("the nav point"))
MAP (WORLD ("c1") IA (2) CLIMATE ("desert") KIND ("reach") POINT (4542 -1468) WORDS ("the nav point"))
MAP (WORLD ("c2") IA (2) CLIMATE ("desert") KIND ("reach") POINT (1707 -761) WORDS ("the nav point"))
MAP (WORLD ("c3") IA (2) CLIMATE ("desert") KIND ("reach") POINT (1071 -1299) WORDS ("the nav point"))
MAP (WORLD ("c4") IA (2) CLIMATE ("desert") KIND ("reach") POINT (2076 -918) WORDS ("the nav point"))
MAP (WORLD ("mw3c1") IA (1) CLIMATE ("tropical") KIND ("reach") POINT (-1189 -1926) WORDS ("the nav point"))
MAP (WORLD ("mw3c2") IA (1) CLIMATE ("tropical") KIND ("reach") POINT (-930 -1886) WORDS ("the nav point"))
MAP (WORLD ("mw3c2") IA (2) CLIMATE ("tropical") KIND ("reach") POINT (-991 -2093) WORDS ("the nav point"))
MAP (WORLD ("mw3c4") IA (1) CLIMATE ("desert") KIND ("reach") POINT (-536 1585) WORDS ("the nav point"))
; Attack (MW1's special target).
MAP (WORLD ("c1") IA (2) CLIMATE ("desert") KIND ("attack") NODE ("hitme_twr") WORDS ("the dome core"))
MAP (WORLD ("c2") IA (2) CLIMATE ("desert") KIND ("attack") NODE ("portalgate") WORDS ("the portal gate"))
MAP (WORLD ("c3") IA (2) CLIMATE ("desert") KIND ("attack") NODE ("pspwrsrc01") WORDS ("the power generator"))
MAP (WORLD ("c4") IA (2) CLIMATE ("desert") KIND ("attack") NODE ("warehouse_target40") WORDS ("the warehouse"))
MAP (WORLD ("mw3c2") IA (2) CLIMATE ("tropical") KIND ("attack") NODE ("iatower") WORDS ("the tower"))
MAP (WORLD ("mw3c1") IA (2) CLIMATE ("tropical") KIND ("attack") NODE ("iatower") WORDS ("the tower"))
MAP (WORLD ("mw3c3") IA (2) CLIMATE ("tropical") KIND ("attack") NODE ("iatower") WORDS ("the tower"))
MAP (WORLD ("mw3c4") IA (2) CLIMATE ("desert") KIND ("attack") NODE ("iatower") WORDS ("the tower"))
; Defend (MW1's defend special target and oppose withdrawal).
MAP (WORLD ("c1") IA (3) CLIMATE ("desert") KIND ("defend") NODE ("pship_kill") WORDS ("the pirate ship"))
MAP (WORLD ("c2") IA (3) CLIMATE ("desert") KIND ("defend") NODE ("mp_tent_campb") WORDS ("the headquarters"))
MAP (WORLD ("c2") IA (3) CLIMATE ("desert") KIND ("defend") NODE ("tcab05") WORDS ("the germanium transport"))
MAP (WORLD ("c3") IA (3) CLIMATE ("desert") KIND ("defend") NODE ("pspwrsrc01") WORDS ("the power generator"))
MAP (WORLD ("c4") IA (3) CLIMATE ("desert") KIND ("defend") NODE ("warehouse_target40") WORDS ("the warehouse"))
MAP (WORLD ("mw3c2") IA (3) CLIMATE ("tropical") KIND ("defend") NODE ("iatower") WORDS ("the tower"))
MAP (WORLD ("mw3c1") IA (3) CLIMATE ("tropical") KIND ("defend") NODE ("iatower") WORDS ("the tower"))
MAP (WORLD ("mw3c3") IA (3) CLIMATE ("tropical") KIND ("defend") NODE ("iatower") WORDS ("the tower"))
MAP (WORLD ("mw3c4") IA (3) CLIMATE ("desert") KIND ("defend") NODE ("iatower") WORDS ("the tower"))
)
