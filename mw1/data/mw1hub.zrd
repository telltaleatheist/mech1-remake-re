    ; MW1's tiles (DS:1083): the left column; DEPLOY in the office's place with a contract (DS:10D7).
    COMPANY (POSITION (16 76) BITMAP ("mw1_tile_company") ROLLOVER (BITMAP ("mw1_tile_company_lit")) ACTIVATE (BITMAP ("mw1_tile_company_down")) DISABLE (BITMAP ("mw1_tile_company_off")) LABEL_AT (70 163) LABEL_FONT ("mw1_tile_label") LABEL_OFF_FONT ("mw1_tile_label_off"))
    MARKET (POSITION (16 186) BITMAP ("mw1_tile_mech_complex") ROLLOVER (BITMAP ("mw1_tile_mech_complex_lit")) ACTIVATE (BITMAP ("mw1_tile_mech_complex_down")) DISABLE (BITMAP ("mw1_tile_mech_complex_off")) LABEL_AT (70 273) LABEL_FONT ("mw1_tile_label") LABEL_OFF_FONT ("mw1_tile_label_off"))
    OFFICE (POSITION (16 296) BITMAP ("mw1_tile_house_kurita") ROLLOVER (BITMAP ("mw1_tile_house_kurita_lit")) ACTIVATE (BITMAP ("mw1_tile_house_kurita_down")) DISABLE (BITMAP ("mw1_tile_house_kurita_off")) LABEL_AT (70 383) LABEL_FONT ("mw1_tile_label") LABEL_OFF_FONT ("mw1_tile_label_off"))
    DEPLOY (POSITION (16 296) BITMAP ("mw1_tile_deploy") ROLLOVER (BITMAP ("mw1_tile_deploy_lit")) ACTIVATE (BITMAP ("mw1_tile_deploy_down")) DISABLE (BITMAP ("mw1_tile_deploy_off")) LABEL_AT (70 383) LABEL_FONT ("mw1_tile_label") LABEL_OFF_FONT ("mw1_tile_label_off"))
    ; The right column.
    TRAVEL (POSITION (729 76) BITMAP ("mw1_tile_starport") ROLLOVER (BITMAP ("mw1_tile_starport_lit")) ACTIVATE (BITMAP ("mw1_tile_starport_down")) DISABLE (BITMAP ("mw1_tile_starport_off")) LABEL_AT (783 163) LABEL_FONT ("mw1_tile_label") LABEL_OFF_FONT ("mw1_tile_label_off") ANCHOR ("RIGHT"))
    BAR (POSITION (729 186) BITMAP ("mw1_tile_bar") ROLLOVER (BITMAP ("mw1_tile_bar_lit")) ACTIVATE (BITMAP ("mw1_tile_bar_down")) DISABLE (BITMAP ("mw1_tile_bar_off")) LABEL_AT (783 273) LABEL_FONT ("mw1_tile_label") LABEL_OFF_FONT ("mw1_tile_label_off") ANCHOR ("RIGHT"))
    OPTIONS (POSITION (729 296) BITMAP ("mw1_tile_options") ROLLOVER (BITMAP ("mw1_tile_options_lit")) ACTIVATE (BITMAP ("mw1_tile_options_down")) DISABLE (BITMAP ("mw1_tile_options_off")) LABEL_AT (783 383) LABEL_FONT ("mw1_tile_label") LABEL_OFF_FONT ("mw1_tile_label_off") ANCHOR ("RIGHT"))
  )
  TEXTS (
    PLANET (POSITION (166 15) FONT ("mw1_plaque"))
    HOUSE (POSITION (166 47) FONT ("mw1_plaque_sub"))
    DATE (POSITION (687 15) FONT ("mw1_plaque") ANCHOR ("RIGHT"))
    DAY (POSITION (687 47) FONT ("mw1_plaque_sub") ANCHOR ("RIGHT"))
    PANEL_TITLE (POSITION (213 84) FONT ("mw1_panel_title") ANCHOR ("CENTRE"))
    PANEL_LINES (POSITION (213 107) FONT ("mw1_panel_line") GAP (15) ANCHOR ("CENTRE"))
    TERM_TITLE (POSITION (323 305) FONT ("mw1_term_title") ANCHOR ("CENTRE"))
    TERM_LABELS (POSITION (323 328) FONT ("mw1_term_dim") GAP (15) ANCHOR ("CENTRE"))
    TERM_VALUES (POSITION (531 328) FONT ("mw1_term_value") GAP (15) ANCHOR ("CENTRE"))
    TERM_MECHS (POSITION (323 396) FONT ("mw1_term_line") GAP (15) ANCHOR ("CENTRE"))
    TERM_PILOTS (POSITION (531 396) FONT ("mw1_term_value") GAP (15) ANCHOR ("CENTRE"))
    STATUS_WORLD (POSITION (20 460) FONT ("mw1_status_world"))
    STATUS (POSITION (136 461) FONT ("mw1_status"))
  )
)
