; MW1: Critical Hit's planet hub (src/mw1_hub.h), on MW1's screen template
; (src/mw1_screen.h, whose keys ANCHOR, LABEL_AT, LABEL_FONT, LABEL_OFF_FONT,
; TEXTS and the _WIDE layout are ours; the game's own readers ignore them).
; The look is the owner's hub mockup's (mockups/mw1-hub.html), in MW1's layout:
; - the world's scenery full-bleed (the BACKGROUND; the hub names the world's,
;   mw1_scenery.h), drawn centred;
; - two plaques across the top: the world and its House, the date, and between
;   them the company's strip (C-BILLS, PAYROLL, KILLS: the owner on item 16, MW1's
;   hub had no company box);
; - the services as picture tiles where MW1's hub tables put them (FIXES.md
;   item 11, MW_MAIN.EXE DS:1083): COMPANY, MECH COMPLEX and the world's House
;   office down the left, STARPORT, BAR and OPTIONS down the right; with a
;   contract accepted (DS:10D7) DEPLOY in the office's place, the right column
;   gone (the hub hides what isn't there);
; - the middle panel only with something to say (item 16): AFTER ACTION, or
;   the messages (payday, the news, a contract taken), OK (and AFTER ACTION's
;   REPLAY, or the messages' READ) under it; else the scenery and the tiles alone. Item 42 (the owner:
;   unobtrusive): a box at the foot between the tile columns, sized to its
;   lines (mw1_box_<w>_<lines>, grown upward from the status line; the hub
;   names the size and moves the texts down from the six-line box's places),
;   OK and REPLAY inside its foot, six lines a page;
; - the status line along the foot: the world, and what to do, the contract
;   taken, or the tile under the mouse.
; All MW1's own art (mw1image.zbd: data-src/art, src/mw1_chrome.h), the
; cursor too: nothing of Pirate's Moon's (FIXES.md item 5; tests/test_mw1_look.cpp).
;
; MW1HUBDIALOG is 4:3's (640); MW1HUBDIALOG_WIDE the 16:9 canvas's (853).
; MW1HUBOPTIONS (and _WIDE): the hub's OPTIONS, over its scenery.
(
MW1HUBDIALOG (
  CURSOR (BITMAP ("mw1_cursor") CENTER (1))
  PRIMITIVES (
    BACKGROUND (POSITION (-107 0) BITMAP ("mw1_hub_desert_starport") ANCHOR ("CENTRE"))
    PANEL (POSITION (12 8) BITMAP ("mw1_plaque_narrow"))
    PANEL2 (POSITION (420 8) BITMAP ("mw1_plaque_narrow"))
    PANEL3 (POSITION (132 274) BITMAP ("mw1_box_376_6"))
    ; The company's strip between the plaques.
    PANEL4 (POSITION (224 8) BITMAP ("mw1_strip"))
    PANEL5 (POSITION (-107 454) BITMAP ("mw1_statusbar") ANCHOR ("CENTRE"))
  )
  BUTTONS (
    ; Inside the box's foot while it shows (AFTER ACTION's REPLAY left of OK).
    OK (POSITION (324 406) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (416 412) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    REPLAY (POSITION (148 406) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (240 412) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    ; MW1's tiles (DS:1083): the left column; DEPLOY in the office's place with a contract (DS:10D7).
    COMPANY (POSITION (12 76) BITMAP ("mw1_tile_company") ROLLOVER (BITMAP ("mw1_tile_company_lit")) ACTIVATE (BITMAP ("mw1_tile_company_down")) DISABLE (BITMAP ("mw1_tile_company_off")) LABEL_AT (66 163) LABEL_FONT ("mw1_tile_label") LABEL_OFF_FONT ("mw1_tile_label_off"))
    MARKET (POSITION (12 186) BITMAP ("mw1_tile_mech_complex") ROLLOVER (BITMAP ("mw1_tile_mech_complex_lit")) ACTIVATE (BITMAP ("mw1_tile_mech_complex_down")) DISABLE (BITMAP ("mw1_tile_mech_complex_off")) LABEL_AT (66 273) LABEL_FONT ("mw1_tile_label") LABEL_OFF_FONT ("mw1_tile_label_off"))
    OFFICE (POSITION (12 296) BITMAP ("mw1_tile_house_kurita") ROLLOVER (BITMAP ("mw1_tile_house_kurita_lit")) ACTIVATE (BITMAP ("mw1_tile_house_kurita_down")) DISABLE (BITMAP ("mw1_tile_house_kurita_off")) LABEL_AT (66 383) LABEL_FONT ("mw1_tile_label") LABEL_OFF_FONT ("mw1_tile_label_off"))
    DEPLOY (POSITION (12 296) BITMAP ("mw1_tile_deploy") ROLLOVER (BITMAP ("mw1_tile_deploy_lit")) ACTIVATE (BITMAP ("mw1_tile_deploy_down")) DISABLE (BITMAP ("mw1_tile_deploy_off")) LABEL_AT (66 383) LABEL_FONT ("mw1_tile_label") LABEL_OFF_FONT ("mw1_tile_label_off"))
    ; The right column.
    TRAVEL (POSITION (520 76) BITMAP ("mw1_tile_starport") ROLLOVER (BITMAP ("mw1_tile_starport_lit")) ACTIVATE (BITMAP ("mw1_tile_starport_down")) DISABLE (BITMAP ("mw1_tile_starport_off")) LABEL_AT (574 163) LABEL_FONT ("mw1_tile_label") LABEL_OFF_FONT ("mw1_tile_label_off"))
    BAR (POSITION (520 186) BITMAP ("mw1_tile_bar") ROLLOVER (BITMAP ("mw1_tile_bar_lit")) ACTIVATE (BITMAP ("mw1_tile_bar_down")) DISABLE (BITMAP ("mw1_tile_bar_off")) LABEL_AT (574 273) LABEL_FONT ("mw1_tile_label") LABEL_OFF_FONT ("mw1_tile_label_off"))
    OPTIONS (POSITION (520 296) BITMAP ("mw1_tile_options") ROLLOVER (BITMAP ("mw1_tile_options_lit")) ACTIVATE (BITMAP ("mw1_tile_options_down")) DISABLE (BITMAP ("mw1_tile_options_off")) LABEL_AT (574 383) LABEL_FONT ("mw1_tile_label") LABEL_OFF_FONT ("mw1_tile_label_off"))
    ; FIXES.md item 47: the journal, under the right column (alone there with a contract).
    STORY (POSITION (520 414) BITMAP ("mw1_button_tile") ROLLOVER (BITMAP ("mw1_button_tile_lit")) ACTIVATE (BITMAP ("mw1_button_tile_down")) DISABLE (BITMAP ("mw1_button_tile_off")) LABEL_AT (574 420) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    ; FIXES.md items 62, 63: READ (the messages' news stories) in REPLAY's place; LOG under the left column, always.
    READ (POSITION (148 406) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (240 412) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    LOG (POSITION (12 414) BITMAP ("mw1_button_tile") ROLLOVER (BITMAP ("mw1_button_tile_lit")) ACTIVATE (BITMAP ("mw1_button_tile_down")) DISABLE (BITMAP ("mw1_button_tile_off")) LABEL_AT (66 420) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    ; FIXES.md item 100: QUIT at the foot, between LOG and STORY (gone while the box shows); PM's quit box asks.
    QUIT (POSITION (266 414) BITMAP ("mw1_button_tile") ROLLOVER (BITMAP ("mw1_button_tile_lit")) ACTIVATE (BITMAP ("mw1_button_tile_down")) DISABLE (BITMAP ("mw1_button_tile_off")) LABEL_AT (320 420) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
  )
  TEXTS (
    PLANET (POSITION (116 15) FONT ("mw1_plaque"))
    HOUSE (POSITION (116 47) FONT ("mw1_plaque_sub"))
    DATE (POSITION (524 15) FONT ("mw1_plaque"))
    DAY (POSITION (524 47) FONT ("mw1_plaque_sub"))
    PANEL_TITLE (POSITION (148 284) FONT ("mw1_panel_title"))
    PANEL_LINES (POSITION (148 308) FONT ("mw1_panel_line") GAP (15))
    STRIP_LABELS (POSITION (236 15) FONT ("mw1_strip_label") GAP (15))
    STRIP_VALUES (POSITION (404 13) FONT ("mw1_strip_value") GAP (15))
    STATUS_WORLD (POSITION (16 460) FONT ("mw1_status_world"))
    STATUS (POSITION (132 461) FONT ("mw1_status"))
  )
)
