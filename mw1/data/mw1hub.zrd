  PRIMITIVES (
    BACKGROUND (POSITION (-107 0) BITMAP ("mw1_hub_desert_starport") ANCHOR ("CENTRE"))
    PANEL (POSITION (-107 0) BITMAP ("mw1_clear") ANCHOR ("CENTRE"))
    PANEL2 (POSITION (204 106) BITMAP ("mw1_panel_232x256"))
    PANEL3 (POSITION (-107 454) BITMAP ("mw1_statusbar") ANCHOR ("CENTRE"))
  )
  BUTTONS (
    SETTINGS (POSITION (236 152) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (328 158) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    ; FIXES 125: SAVE GAME and LOAD GAME, the save slots. FIXES 126: the sound is in SETTINGS now.
