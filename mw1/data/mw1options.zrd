    ACCEPT (POSITION (16 352) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL ("ACCEPT" 92 7 font "mw1_label") RADIUS (0) MAXRADIUS (0))
    BACK (POSITION (16 392) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL ("BACK" 92 7 font "mw1_label") RADIUS (0) MAXRADIUS (0))
