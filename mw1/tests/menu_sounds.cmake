# Issue #19 in MW1 (FIXES.md item 148): its layouts name no button sounds, so every button was silent; under SMALL
# FIXES they take Pirate's Moon's menu sounds. The title, and the pause, QUIT, the results and the
# hub after (the pause released its own sounds by then). With --original nothing sounds.
# cmake -DMW1_BIN=<mw1> -DDIR=<scratch> -P menu_sounds.cmake
cmake_minimum_required(VERSION 3.20)
set(failed)
function(sounds name screen args out_rollover out_select)
  set(wd "${DIR}/${name}")
  file(REMOVE_RECURSE "${wd}")
  file(MAKE_DIRECTORY "${wd}")
  separate_arguments(list UNIX_COMMAND "${args}")
  execute_process(COMMAND ${CMAKE_COMMAND} -E env MW1_SEED=7 MW3_SOUND_LOG=1 SDL_AUDIODRIVER=dummy ${screen} "${MW1_BIN}"
                          --write-dir "${wd}" --hidden --window 1280x960 --frame-ms 16 --verbose ${list}
                  RESULT_VARIABLE r OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 300)
  if(NOT r EQUAL 0)
    message(SEND_ERROR "${name}: exit ${r}")
  endif()
  string(REGEX MATCHALL "menu sound menu_rollover plays" a "${out}")
  string(REGEX MATCHALL "menu sound menu_select plays" b "${out}")
  list(LENGTH a na)
  list(LENGTH b nb)
  message("${name}: ${na} rollovers, ${nb} selects")
  set(${out_rollover} ${na} PARENT_SCOPE)
  set(${out_select} ${nb} PARENT_SCOPE)
endfunction()
set(title "--hover-at 124,314@700 --hover-at 300,200@750 --hover-at 124,390@800 --hover-at 300,200@850 --hover-at 124,314@900 --click-at 124,314@1000 --frames 1050")
set(after "--hover-at 128,317@250 --click-at 128,317@300 --hover-at 300,200@600 --hover-at 320,460@650 --click-at 320,460@750 --frames 800")
sounds(title "" "${title}" ra sa)
if(NOT ra GREATER 2 OR NOT sa GREATER 0)
  list(APPEND failed "title")
endif()
sounds(after "MW1_SCREEN=pause" "${after}" rb sb)
if(NOT rb GREATER 1 OR NOT sb GREATER 1)
  list(APPEND failed "pause and results")
endif()
sounds(title_off "" "${title} --original" rc sc)
sounds(after_off "MW1_SCREEN=pause" "${after} --original" rd sd)
if(rc OR sc OR rd OR sd)
  list(APPEND failed "--original")
endif()
if(failed)
  message(FATAL_ERROR "menu sounds: ${failed}")
endif()
