From 3bb3e6555bb0bfc95f34134c1e06894246247f84 Mon Sep 17 00:00:00 2001
From: mw1-dev <noreply@anthropic.com>
Date: Fri, 20 Nov 2026 16:22:10 -0500
Subject: [PATCH 2/2] Case-insensitive installation opens off Windows and
 macOS: after an exact miss, the one directory entry matching without regard
 to case (the cockpit asks for lower-case .bmp names; installs are in DOS
 capitals)

---
 src/SDL/SDLBackend_CombatProcess.c  |  5 ++---
 src/SDL/SDLBackend_Files.c          | 33 ++++++++++++++++++++++++++++-
 src/include/mechwarrior/dos_files.h |  2 ++
 3 files changed, 36 insertions(+), 4 deletions(-)

diff --git a/src/SDL/SDLBackend_CombatProcess.c b/src/SDL/SDLBackend_CombatProcess.c
index 9117158..d24f255 100644
--- a/src/SDL/SDLBackend_CombatProcess.c
+++ b/src/SDL/SDLBackend_CombatProcess.c
@@ -1,3 +1,4 @@
+#include "mechwarrior/dos_files.h"
 #include "SDLBackend.h"
 #include "mechwarrior/launcher.h"
 #include "mechwarrior/combat_installation.h"
@@ -113,9 +114,7 @@ static FILE *OpenStream(const char *filename,const char *mode)
     /* Original resources are flat installation files. Never change the shared
      * working directory or let a native filename escape the installation. */
     if (!filename[0] || strpbrk(filename,"/\\:")) return NULL;
-    char path[4096];
-    if (snprintf(path,sizeof(path),"%s/%s",gameDirectory,filename)>=(int)sizeof(path)) return NULL;
-    return fopen(path,mode);
+    return MwHostOpenInstallationFile(gameDirectory,filename,mode);
 }
 static int16_t CloseHandle(uint16_t handle)
 {
diff --git a/src/SDL/SDLBackend_Files.c b/src/SDL/SDLBackend_Files.c
index cdc68c1..c05fc86 100644
--- a/src/SDL/SDLBackend_Files.c
+++ b/src/SDL/SDLBackend_Files.c
@@ -14,6 +14,7 @@
 #else
 #include <dirent.h>
 #include <sys/stat.h>
+#include <strings.h>
 #endif
 
 enum { DOS_FIRST_FILE_HANDLE = 5, DOS_FILE_HANDLE_COUNT = 20, HOST_PATH_BYTES = 4096,
@@ -49,6 +50,36 @@ static uint16_t HostGetDosFileError(void)
     if (errno == EMFILE) return DOS_ERROR_TOO_MANY_FILES;
     return DOS_ERROR_ACCESS_DENIED;
 }
+/* The game names its files in DOS capitals, and a few (the cockpit's .bmp files)
+ * in lower case. Windows and macOS match either; elsewhere, after an exact miss,
+ * take the one directory entry that matches without regard to case. */
+FILE *MwHostOpenInstallationFile(const char *directory,const char *filename,const char *mode)
+{
+    char path[HOST_PATH_BYTES];
+    if (snprintf(path,sizeof(path),"%s%s%s",directory,directory[0]?"/":"",filename)>=(int)sizeof(path))
+    {errno=ENAMETOOLONG;return NULL;}
+    FILE *file=fopen(path,mode);
+#if !defined(_WIN32)
+    if (!file && errno==ENOENT)
+    {
+        DIR *listing=opendir(directory[0]?directory:".");
+        if (!listing) {errno=ENOENT;return NULL;}
+        bool matched=false;
+        for (struct dirent *entry;(entry=readdir(listing))!=NULL;)
+        {
+            if (strcasecmp(entry->d_name,filename)) continue;
+            matched=true;
+            if (snprintf(path,sizeof(path),"%s%s%s",directory,directory[0]?"/":"",entry->d_name)<(int)sizeof(path))
+                file=fopen(path,mode);
+            break;
+        }
+        int openError=errno;
+        closedir(listing);
+        errno=matched?openError:ENOENT;
+    }
+#endif
+    return file;
+}
 static bool HostOpenFileReadWrite(const char *filename, uint16_t *handleOrError)
 {
     char path[HOST_PATH_BYTES];
@@ -65,7 +96,7 @@ static bool HostOpenFileReadWrite(const char *filename, uint16_t *handleOrError)
         if (fileStreams[handle] != NULL) continue;
         /* Native AL=02 asks read-write. Only a save is ever written, so the original
          * installation is opened read-only: it may be on read-only media. */
-        fileStreams[handle] = fopen(path, saveFile ? "r+b" : "rb");
+        fileStreams[handle] = MwHostOpenInstallationFile(directory, filename, saveFile ? "r+b" : "rb");
         if (fileStreams[handle] == NULL) { *handleOrError = HostGetDosFileError(); return true; }
         *handleOrError = handle; return false;
     }
diff --git a/src/include/mechwarrior/dos_files.h b/src/include/mechwarrior/dos_files.h
index fba470f..c5bddfd 100644
--- a/src/include/mechwarrior/dos_files.h
+++ b/src/include/mechwarrior/dos_files.h
@@ -2,6 +2,7 @@
 #define MECHWARRIOR_DOS_FILES_H
 #include <stdbool.h>
 #include <stdint.h>
+#include <stdio.h>
 
 /* INT21 file boundary: true means Carry set; AX output is count/handle/error. */
 typedef struct MwDosFileCalls
@@ -23,4 +24,5 @@ extern void (*mwHostValidateFileDestination)(const uint8_t *buffer,uint16_t byte
 bool MwHostSetOriginalGameDirectory(const char *directory);
 bool MwHostSetCampaignSaveDirectory(const char *directory);
 void MwHostCloseProcessFiles(void);
+FILE *MwHostOpenInstallationFile(const char *directory,const char *filename,const char *mode);
 #endif
