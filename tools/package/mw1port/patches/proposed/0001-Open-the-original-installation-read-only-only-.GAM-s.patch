From 82470f625f5cf5e217b9d08eaeab49440960edc6 Mon Sep 17 00:00:00 2001
From: mw1-dev <noreply@anthropic.com>
Date: Fri, 20 Nov 2026 16:21:41 -0500
Subject: [PATCH 1/2] Open the original installation read-only: only .GAM saves
 (in the save directory) are opened read-write

---
 src/SDL/SDLBackend_Files.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/SDL/SDLBackend_Files.c b/src/SDL/SDLBackend_Files.c
index 16d5e7e..cdc68c1 100644
--- a/src/SDL/SDLBackend_Files.c
+++ b/src/SDL/SDLBackend_Files.c
@@ -63,7 +63,9 @@ static bool HostOpenFileReadWrite(const char *filename, uint16_t *handleOrError)
     for (uint16_t handle = DOS_FIRST_FILE_HANDLE; handle < DOS_FILE_HANDLE_COUNT; ++handle)
     {
         if (fileStreams[handle] != NULL) continue;
-        fileStreams[handle] = fopen(path, "r+b"); /* Native AL=02, not read-only. */
+        /* Native AL=02 asks read-write. Only a save is ever written, so the original
+         * installation is opened read-only: it may be on read-only media. */
+        fileStreams[handle] = fopen(path, saveFile ? "r+b" : "rb");
         if (fileStreams[handle] == NULL) { *handleOrError = HostGetDosFileError(); return true; }
         *handleOrError = handle; return false;
     }
